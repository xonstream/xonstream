# Frontend Environment Variables - Example
# Copy this file to .env and fill in your actual values

# Backend API URL - Where your backend server is deployed
# Development: http://localhost:3000 (or your local backend port)
# Production: Your deployed backend URL (e.g., Hugging Face Spaces)
#
# For Cloudflare Pages deployment:
# 1. DO NOT set this in .env file for production
# 2. Instead, set it in Cloudflare Pages dashboard:
#    - Go to Cloudflare Pages → Your Project → Settings → Environment Variables
#    - Add variable: VITE_API_BASE_URL
#    - Value: https://your-huggingface-space.hf.space (your backend URL)
#    - Select environment: Production (and Preview if needed)
#
# Examples:
# Local development: VITE_API_BASE_URL=http://localhost:7860
# Hugging Face backend: VITE_API_BASE_URL=https://your-username-your-space.hf.space
VITE_API_BASE_URL=
