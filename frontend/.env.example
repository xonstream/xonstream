# Frontend Environment Variables - Example
# Copy this file to .env and fill in your actual values

# Backend API URL - OPTIONAL (auto-detection is enabled)
#
# AUTOMATIC ENVIRONMENT DETECTION:
# The code automatically detects where it's running:
# - Localhost (localhost, 127.0.0.1) → http://localhost:7860
# - Cloudflare Pages (*.pages.dev) → https://xonstream-xonstream.hf.space
# - Hugging Face Spaces (*.hf.space) → https://xonstream-xonstream.hf.space
#
# You only need to set this if you want to override the auto-detection.
# Leave it empty to use automatic detection.
#
# Examples:
# Local development (override): VITE_API_BASE_URL=http://localhost:7860
# Custom backend: VITE_API_BASE_URL=https://your-backend.com
VITE_API_BASE_URL=
