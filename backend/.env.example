# Server Configuration
PORT=3000
NODE_ENV=production

# Supabase Database
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Streamtape API
STREAMTAPE_LOGIN=your_streamtape_login_here
STREAMTAPE_KEY=your_streamtape_api_key_here

# SeekStreaming API
SEEKSTREAMING_KEY=your_seekstreaming_key_here
SEEKSTREAMING_PLAYER_DOMAIN=xonstream.seeks.cloud

# Admin Panel
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_admin_password_here
ADMIN_SECRET=your_admin_secret_jwt_key_here

# CORS (Frontend URL)
# For localhost development:
CORS_ORIGIN=http://localhost:5173
# For Hugging Face deployment, set to your frontend URL:
# CORS_ORIGIN=https://xonstream.pages.dev
# Or for multiple origins, the backend now supports regex patterns for *.hf.space and *.pages.dev
