{
  "name": "xonstream-v2",
  "version": "1.0.0",
  "description": "Xonstream Video Streaming Platform - Frontend + Backend",
  "scripts": {
    "dev": "concurrently --kill-others --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "frontend": "cd frontend && npm run dev",
    "backend": "cd backend && npm start",
    "worker:dev": "cd cloudflare-worker && npm run dev",
    "worker:deploy": "cd cloudflare-worker && npx wrangler deploy",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install && cd ../cloudflare-worker && npm install",
    "build": "cd frontend && npm run build",
    "test": "cd frontend && npm test"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
